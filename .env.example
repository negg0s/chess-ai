# Все переменные необязательны, кроме LICHESS_TOKEN.
LICHESS_TOKEN=

# Переопределяет имя бота, полученное из /api/account,
# используется для сравнения id в челленджах/играх.
LICHESS_BOT_ID=

# Имя файла весов в models/ (по умолчанию chess_brain_ultra.pt)
MODEL_FILENAME=chess_brain_ultra.pt

# Полный путь к исполняемому файлу Stockfish; пусто = engine/stockfish.exe
STOCKFISH_PATH=

# Отправлять вызовы maia-ботам автоматически (по умолчанию 1, предыдущее
# поведение)
AUTO_MATCHMAKING=1

# Разрешить нейронную сеть как запасной ход (по умолчанию 0)
USE_NEURAL_FALLBACK=0
